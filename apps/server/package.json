{
  "name": "@catan/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup --config tsup.config.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "start": "node dist/index.js",
    "db": "tsx src/database/cli.ts"
  },
  "dependencies": {
    "@catan/game-core": "workspace:*",
    "@catan/protocol": "workspace:*",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
