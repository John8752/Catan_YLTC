{
  "name": "catan-yltc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @catan/server --filter @catan/web --parallel dev",
    "build": "pnpm -r build",
    "check": "node scripts/testing/run.mjs check",
    "check:all": "node scripts/testing/run.mjs check --scope all",
    "test": "node scripts/testing/run.mjs unit",
    "test:all": "node scripts/testing/run.mjs unit --scope all",
    "test:plan": "node scripts/testing/run.mjs plan",
    "test:inventory": "node scripts/testing/run.mjs inventory",
    "test:boundaries": "vitest run tests/architecture",
    "test:tooling": "node scripts/testing/run.mjs unit --scope tooling",
    "test:e2e": "node scripts/testing/run.mjs e2e",
    "test:e2e:all": "node scripts/testing/run.mjs e2e --scope all",
    "validate": "node scripts/testing/run.mjs validate",
    "validate:tooling": "node scripts/testing/run.mjs validate --scope tooling",
    "validate:all": "node scripts/testing/run.mjs validate --scope all --build",
    "validate:full": "node scripts/testing/run.mjs validate --scope all --build --browser",
    "test:platform": "node scripts/testing/run.mjs unit --scope platform",
    "check:platform": "node scripts/testing/run.mjs check --scope platform",
    "validate:platform": "node scripts/testing/run.mjs validate --scope platform",
    "test:e2e:platform": "node scripts/testing/run.mjs e2e --scope platform",
    "test:e2e:platform:mobile": "node scripts/testing/run.mjs e2e --scope platform --grep @primary-phone",
    "test:catan": "node scripts/testing/run.mjs unit --scope catan",
    "check:catan": "node scripts/testing/run.mjs check --scope catan",
    "validate:catan": "node scripts/testing/run.mjs validate --scope catan",
    "test:e2e:catan": "node scripts/testing/run.mjs e2e --scope catan",
    "test:e2e:catan:mobile": "node scripts/testing/run.mjs e2e --scope catan --grep @primary-phone",
    "test:draw-guess": "node scripts/testing/run.mjs unit --scope draw-guess",
    "check:draw-guess": "node scripts/testing/run.mjs check --scope draw-guess",
    "validate:draw-guess": "node scripts/testing/run.mjs validate --scope draw-guess",
    "test:e2e:draw-guess": "node scripts/testing/run.mjs e2e --scope draw-guess",
    "test:e2e:draw-guess:mobile": "node scripts/testing/run.mjs e2e --scope draw-guess --grep @primary-phone",
    "test:core": "node scripts/testing/run.mjs unit --layer core",
    "test:protocol": "node scripts/testing/run.mjs unit --layer protocol",
    "test:server": "node scripts/testing/run.mjs unit --layer server",
    "test:web": "node scripts/testing/run.mjs unit --layer web",
    "test:catan:replay": "pnpm --filter @catan/game-core exec vitest run src/engine/replay.test.ts -t \"replays a complete legal match\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.18.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "@babel/parser": "7.29.8"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.16"
  }
}
